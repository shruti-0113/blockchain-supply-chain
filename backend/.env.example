# --- Backend (local) ---
PORT=5000
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MNEMONIC=test test test test test test test test test test test junk

# On Vercel, set these as Project Environment Variables instead of a .env file:
#   RPC_URL            = your Sepolia RPC (e.g. https://eth-sepolia.g.alchemy.com/v2/KEY)
#   CONTRACT_ADDRESS   = address printed by the Sepolia deploy
#   MNEMONIC           = the 12-word mnemonic used by the deployer
